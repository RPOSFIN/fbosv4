          <>
            <Panel title="Trend Section">
              <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <TrendBar label="Sales Trend" score={m.trends.salesTrend} color="bg-emerald-500" />
