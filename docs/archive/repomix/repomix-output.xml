export const FBOS_ROLES = [
  "super_admin",
  "admin",
  "sales",
  "call_coach",
  "operations",
  "accounts",
  "viewer",
] as const;

export type FbosRole = (typeof FBOS_ROLES)[number];

export type PermissionAction = "read" | "create" | "update" | "delete";

export type PermissionResource =
  | "dashboard"
  | "leads"
  | "followups"
  | "quotations"
  | "clients"
  | "jobs"
  | "call_coach_notes"
