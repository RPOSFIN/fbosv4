    <Link href={href} className={`${panelPad} block hover:border-blue-400 transition-colors`}>
      <h3 className="text-base font-bold text-slate-900">{title}</h3>
      <p className="text-sm text-slate-500 mt-1">{desc}</p>
    </Link>
  );
}
