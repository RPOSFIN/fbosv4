# FBOS V4 — copy to .env.local and fill in values (never commit .env.local)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct DB access for schema export
# DATABASE_URL=postgresql://...

# Google Sheets / Apps Script
GOOGLE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_SHEET_ID=
GOOGLE_WEBAPP_URL=
GOOGLE_SHEETS_WEBAPP_URL=
SHEET_SYNC_SECRET=
GOOGLE_SHEET_GID=
GOOGLE_SHEET_GID_LEADS=
GOOGLE_SHEET_GID_OPERATIONS=
GOOGLE_SHEET_GID_FINANCE=
GOOGLE_SHEET_GID_CLIENTS=
GOOGLE_SHEET_GID_FOLLOWUPS=
GOOGLE_SHEET_GID_QUOTATIONS=
GOOGLE_SHEET_GID_ORDERS=
GSHEET_CSV_URL=

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_SPACE_ID=
CLICKUP_FOLDER_ID=
CLICKUP_LIST_ID=

# Tally (optional — demo mode works without live bridge)
TALLY_HOST=
TALLY_SERVER_URL=
TALLY_PORT=9000
TALLY_COMPANY_NAME=
TALLY_DEMO_XML=

# Auth (leave unset until auth sub-phase approved)
# NEXT_PUBLIC_AUTH_DISABLED=true
# FBOS_AUTH_DISABLED=true
